pipeline {
    agent any

    tools {
        maven 'Maven3'
        jdk 'JDK'
    }

    stages {

        stage('Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/PRANSHU9999/Wipro-Assignments.git'
            }
        }

        stage('Clean') {
            steps {
                dir('TutorialsNinja_Project') {
                    bat 'mvn clean'
                }
            }
        }

        stage('Compile') {
            steps {
                dir('TutorialsNinja_Project') {
                    bat 'mvn compile'
                }
            }
        }

        stage('Test') {
            steps {
                dir('TutorialsNinja_Project') {
                    bat 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                dir('TutorialsNinja_Project') {
                    bat 'mvn package'
                }
            }
        }
    }

    post {
        success {
            echo 'Build Successful'
        }

        failure {
            echo 'Build Failed'
        }
    }
}